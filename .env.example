# Required: shared password for the web UI login
FUSION_PASSWORD=change-me
# Secret used to sign the session cookie (any long random string)
FUSION_COOKIE_SECRET=change-me-too
# Bind address / port
FUSION_HOST=0.0.0.0
FUSION_PORT=7788
# Per-provider concurrency caps (codex: raise after upgrading to Pro)
CODEX_MAX_CONCURRENCY=1
# Per-lane timeout in seconds
LANE_TIMEOUT_SEC=300
