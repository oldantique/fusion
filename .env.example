# Fusion configuration — this file is the single home for every setting and its default.
# Copy to .env and edit. Values are read once at startup by src/config.ts.

# --- required ---
# Shared password for the web UI login.
FUSION_PASSWORD=change-me
# Any long random string; signs the session cookie. Rotate it to log everyone out.
FUSION_COOKIE_SECRET=change-me-too

# --- network (defaults shown) ---
# Bind address. Default (unset) is 127.0.0.1 = this machine only. Set 0.0.0.0 to reach the UI
# from the LAN/Tailscale — deliberate opt-in: there is no TLS, only the password + signed cookie.
FUSION_HOST=0.0.0.0
FUSION_PORT=7788

# --- lanes ---
# Seconds each model call may take before it is killed (a timeout is not retried; see
# src/providers/lane.ts for which failures are).
LANE_TIMEOUT_SEC=300
# Max simultaneous calls per provider across all conversations.
# Codex defaults to 1 (OpenAI asks that one auth.json not be shared by concurrent jobs);
# raise it after upgrading to a Pro plan.
CLAUDE_MAX_CONCURRENCY=8
CODEX_MAX_CONCURRENCY=1
KIMI_MAX_CONCURRENCY=8
GROK_MAX_CONCURRENCY=8

# --- models ---
# Reasoning effort passed to claude/codex/grok; the accepted set is in src/config.ts (startup
# fails on anything else, because at least one CLI silently ignores unknown values). kimi's
# effort is its own global config.
FUSION_EFFORT=high
# Effort for the synthesizer call only (merging answers is a different job from producing one).
# Unset means "same as FUSION_EFFORT".
FUSION_SYNTH_EFFORT=high
# Model ids as each CLI expects them.
CLAUDE_MODEL=opus
CODEX_MODEL=gpt-5.6-sol
KIMI_MODEL=kimi-code/k3
GROK_MODEL=grok-4.6

# --- conversation memory ---
# Replayed history (earlier questions + fused answers) is trimmed from the oldest turn
# once it exceeds this many characters.
HISTORY_CHAR_BUDGET=60000
