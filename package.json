{
  "name": "fusion",
  "version": "0.1.0",
  "description": "Self-hosted multi-model fusion over local subscription CLIs (claude, codex, kimi, grok)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server/main.ts",
    "start": "node --experimental-strip-types src/server/main.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "build:vendor": "node --experimental-strip-types scripts/build-vendor.ts",
    "postinstall": "npm run build:vendor",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "fuse": "node --experimental-strip-types scripts/fuse-cli.ts",
    "check-docs": "node --experimental-strip-types scripts/check-docs.ts",
    "check-updates": "node --experimental-strip-types scripts/check-updates.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "hono": "^4.7.0",
    "katex": "^0.18.4",
    "marked": "^18.0.10",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
